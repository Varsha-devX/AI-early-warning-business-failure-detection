# ============================================================
# EarlySight AI — AI Early Warning Business Failure Detection
# Environment Configuration
# ============================================================

# --- Application ---
APP_NAME=EarlySight AI
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Database ---
# For local development (SQLite):
DATABASE_URL=sqlite:///./app_data.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/corporate_health

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro

# --- File Storage ---
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
TRAINED_MODELS_DIR=./trained_models

# --- ML Model ---
MODEL_PATH=./trained_models/xgboost_distress_model.joblib
SCALER_PATH=./trained_models/feature_scaler.joblib

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Web Search (Optional) ---
TAVILY_API_KEY=your-tavily-api-key-here
SERPER_API_KEY=your-serper-api-key-here
